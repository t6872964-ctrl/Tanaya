    <style>

        /* =========================
           RESET
        ========================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        :root {
            --blue: #168cff;
            --light-blue: #57b7ff;
            --dark-blue: #0759ad;
            --black: #02060c;
            --dark: #06111f;
            --dark-card: #0b1420;
            --text: #eaf2ff;
            --gray: #aab7c6;
            --border: #1a3550;
            --white: #ffffff;
        }

        body {
            font-family: "Poppins", sans-serif;
            background: var(--black);
            color: var(--text);
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
        }


        /* =========================
           NAVBAR
        ========================== */

        nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 60px;

            display: flex;
            justify-content: space-between;
            align-items: center;

            padding: 0 7%;

            background: rgba(2, 6, 12, 0.97);
            border-bottom: 1px solid rgba(22, 140, 255, 0.25);

            z-index: 1000;
        }

        .logo {
            font-size: 22px;
            font-weight: 800;
            color: white;
        }

        .logo span {
            color: var(--light-blue);
        }

        nav ul {
            list-style: none;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        nav ul a {
            color: #b7c2cf;
            font-size: 12px;
            transition: 0.3s;
        }

        nav ul a:hover {
            color: var(--light-blue);
        }

        .nav-cv {
            background: var(--blue);
            color: white !important;
            padding: 8px 13px;
            border-radius: 7px;
        }


        /* =========================
           HERO
        ========================== */

        .hero {
            padding: 95px 8% 45px;

            display: flex;
            align-items: center;
            justify-content: center;
            gap: 45px;

            background:
                radial-gradient(
                    circle at 15% 50%,
                    rgba(22, 140, 255, 0.20),
                    transparent 32%
                ),
                linear-gradient(
                    180deg,
                    #06111f,
                    #02060c
                );
        }

        .profile-circle {
            width: 270px;
            height: 270px;
            padding: 6px;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    var(--light-blue),
                    var(--dark-blue)
                );

            box-shadow:
                0 0 25px rgba(22, 140, 255, 0.6);
        }

        .profile-circle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center top;
            border-radius: 50%;
        }

        .hero-content {
            max-width: 650px;
        }

        .hello {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .hero h1 {
            font-size: 52px;
            line-height: 1.1;
            margin-bottom: 15px;
        }

        .first-name {
            color: var(--light-blue);
        }

        .last-name {
            color: white;
        }

        .hero p {
            color: var(--gray);
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 7px;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 20px;
        }

        .btn {
            padding: 11px 18px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;

            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;

            cursor: pointer;
            transition: 0.3s;
        }

        .btn-primary {
            background:
                linear-gradient(
                    135deg,
                    var(--light-blue),
                    var(--dark-blue)
                );

            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow:
                0 10px 25px rgba(22, 140, 255, 0.35);
        }

        .btn-outline {
            border: 1px solid var(--blue);
            color: var(--light-blue);
        }

        .btn-outline:hover {
            background: var(--blue);
            color: white;
        }


        /* =========================
           GENERAL SECTION
        ========================== */

        section {
            padding: 45px 8%;
        }

        .section-title {
            text-align: center;
            margin-bottom: 25px;
        }

        .section-title small {
            color: var(--light-blue);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        .section-title h2 {
            font-size: 30px;
            margin-top: 5px;
        }

        .section-title p {
            color: var(--gray);
            font-size: 13px;
            margin-top: 6px;
        }


        /* =========================
           ABOUT
        ========================== */

        .about {
            background: var(--dark);
        }

        .about-container {
            max-width: 1100px;
            margin: auto;

            display: grid;
            grid-template-columns: 1fr 2fr;

            gap: 25px;
            align-items: center;
        }

        .about-card {
            background: var(--dark-card);
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 22px;
        }

        .about-card i {
            color: var(--light-blue);
            font-size: 32px;
            margin-bottom: 10px;
        }

        .about-card h3 {
            margin-bottom: 8px;
        }

        .about-card p,
        .about-text p {
            color: var(--gray);
            font-size: 13px;
            line-height: 1.6;
        }

        .about-text h3 {
            font-size: 23px;
            margin-bottom: 10px;
        }


        /* =========================
           SKILLS
        ========================== */

        .skills-grid {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(220px, 1fr));

            gap: 15px;
        }

        .skill-card {
            background: var(--dark-card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 18px;
            transition: 0.3s;
        }

        .skill-card:hover {
            transform: translateY(-5px);
            border-color: var(--blue);
        }

        .skill-card i {
            color: var(--light-blue);
            font-size: 26px;
            margin-bottom: 10px;
        }

        .skill-card h3 {
            font-size: 16px;
            margin-bottom: 7px;
        }

        .skill-card p {
            color: var(--gray);
            font-size: 12px;
            line-height: 1.5;
        }


        /* =========================
           TECHNICAL SKILLS
        ========================== */

        .technical-skills {
            background: var(--dark);
        }

        .skills-category {
            background: var(--dark-card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 10px;
        }

        .skills-category h3 {
            color: var(--light-blue);
            font-size: 16px;
            margin-bottom: 10px;
        }

        .skill-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .skill-tag {
            padding: 7px 12px;

            background:
                rgba(22, 140, 255, 0.10);

            border:
                1px solid rgba(22, 140, 255, 0.4);

            border-radius: 20px;

            color: #d8ecff;
            font-size: 12px;
        }


        /* =========================
           PROJECTS
        ========================== */

        .projects-grid {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(280px, 1fr));

            gap: 18px;
        }

        .project-card {
            background: var(--dark-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px;
            transition: 0.3s;
        }

        .project-card:hover {
            transform: translateY(-5px);
            border-color: var(--blue);
        }

        .project-icon {
            width: 50px;
            height: 50px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            background:
                rgba(22, 140, 255, 0.12);

            margin-bottom: 12px;
        }

        .project-icon i {
            color: var(--light-blue);
            font-size: 22px;
        }

        .project-card h3 {
            font-size: 17px;
            margin-bottom: 6px;
        }

        .project-date {
            color: var(--light-blue);
            font-size: 11px;
            margin-bottom: 10px;
        }

        .project-card p {
            color: var(--gray);
            font-size: 12px;
            line-height: 1.5;
            margin-bottom: 7px;
        }


        /* =========================
           EDUCATION
        ========================== */

        .education {
            background: var(--dark);
        }

        .education-container {
            max-width: 950px;
            margin: auto;
        }

        .education-card {
            background: var(--dark-card);

            border-left:
                4px solid var(--blue);

            border-radius: 10px;

            padding: 16px;
            margin-bottom: 10px;
        }

        .education-card h3 {
            font-size: 16px;
            margin-bottom: 5px;
        }

        .education-card h4 {
            color: var(--light-blue);
            font-size: 13px;
            margin-bottom: 5px;
        }

        .education-card p {
            color: var(--gray);
            font-size: 12px;
            line-height: 1.5;
        }


        /* =========================
           CV SECTION
        ========================== */

        .cv-section {
            background: var(--black);
        }

        .cv-container {
            max-width: 700px;
            margin: auto;
            text-align: center;
        }

        .cv-image-wrapper {
            background: var(--dark-card);
            border: 1px solid var(--border);

            border-radius: 15px;

            padding: 10px;

            max-height: 480px;
            overflow: hidden;
        }

        .cv-image-wrapper img {
            width: 100%;
            height: 450px;

            object-fit: contain;

            display: block;

            border-radius: 8px;

            cursor: pointer;
        }

        .cv-buttons {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;

            gap: 10px;

            margin-top: 15px;
        }


        /* =========================
           CERTIFICATES
        ========================== */

        .certificate-grid {
            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(230px, 1fr));

            gap: 15px;
        }

        .certificate-card {
            background: var(--dark-card);
            border: 1px solid var(--border);

            border-radius: 15px;
            overflow: hidden;

            transition: 0.3s;
        }

        .certificate-card:hover {
            transform: translateY(-5px);
            border-color: var(--blue);
        }

        .certificate-image {
            height: 140px;
            background: white;
            overflow: hidden;
            cursor: pointer;
        }

        .certificate-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .certificate-content {
            padding: 15px;
        }

        .certificate-content h3 {
            font-size: 14px;
            margin-bottom: 7px;
        }

        .certificate-content p {
            color: var(--gray);
            font-size: 11px;
        }

        .certificate-content i {
            color: var(--light-blue);
        }

        .certificate-buttons {
            display: flex;
            gap: 8px;
            margin-top: 12px;
        }

        .certificate-buttons a {
            flex: 1;

            text-align: center;

            padding: 8px;

            border-radius: 7px;

            font-size: 11px;
        }

        .view-btn {
            border: 1px solid var(--blue);
            color: var(--light-blue);
        }

        .download-btn {
            background: var(--blue);
            color: white;
        }


        /* =========================
           ACHIEVEMENTS
        ========================== */

        .achievements {
            background: var(--dark);
        }

        .achievement-grid {
            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(250px, 1fr));

            gap: 15px;
        }

        .achievement-card {
            background: var(--dark-card);

            border: 1px solid var(--border);

            border-radius: 15px;

            padding: 20px;

            text-align: center;
        }

        .achievement-card i {
            font-size: 32px;
            color: var(--light-blue);
            margin-bottom: 10px;
        }

        .achievement-card h3 {
            font-size: 16px;
            margin-bottom: 7px;
        }

        .achievement-card p {
            color: var(--gray);
            font-size: 12px;
        }


        /* =========================
           CONTACT
        ========================== */

        .contact-wrapper {
            max-width: 1000px;
            margin: auto;

            background: var(--dark-card);

            border: 1px solid var(--border);
            border-top: 3px solid var(--blue);

            border-radius: 18px;

            padding: 22px;
        }

        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .contact-form input,
        .contact-form textarea {
            width: 100%;

            padding: 12px 15px;

            background: #07101a;

            border: 1px solid var(--border);

            border-radius: 8px;

            color: white;

            font-family: "Poppins", sans-serif;
        }

        .contact-form textarea {
            min-height: 100px;
        }

        .contact-form button {
            padding: 12px;

            border: none;

            border-radius: 8px;

            background:
                linear-gradient(
                    135deg,
                    var(--light-blue),
                    var(--dark-blue)
                );

            color: white;

            font-size: 14px;
            font-weight: 700;

            cursor: pointer;
        }

        .contact-info {
            max-width: 1000px;

            margin: 18px auto;

            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(180px, 1fr));

            gap: 12px;
        }

        .contact-box {
            background: var(--dark-card);

            border: 1px solid var(--border);

            border-radius: 12px;

            padding: 15px;

            text-align: center;
        }

        .contact-box i {
            color: var(--light-blue);

            font-size: 22px;

            margin-bottom: 7px;
        }

        .contact-box h3 {
            font-size: 14px;
            margin-bottom: 4px;
        }

        .contact-box a {
            color: var(--gray);
            font-size: 11px;
            word-break: break-word;
        }


        /* =========================
           FOOTER
        ========================== */

        footer {
            background: #010306;

            border-top: 1px solid #142030;

            padding: 15px;

            text-align: center;

            color: #8491a0;

            font-size: 12px;
        }

        footer span {
            color: var(--light-blue);
        }


        /* =========================
           IMAGE MODAL
        ========================== */

        .modal {
            display: none;

            position: fixed;

            top: 0;
            left: 0;

            width: 100%;
            height: 100%;

            background:
                rgba(0, 0, 0, 0.95);

            z-index: 5000;

            align-items: center;
            justify-content: center;

            padding: 20px;
        }

        .modal-content {
            position: relative;

            max-width: 900px;
            width: 100%;

            text-align: center;
        }

        .modal-content img {
            max-width: 100%;
            max-height: 85vh;

            border-radius: 8px;

            border: 2px solid var(--blue);
        }

        .close {
            position: absolute;

            right: 0;
            top: -45px;

            color: white;

            font-size: 35px;

            cursor: pointer;
        }


        /* =========================
           RESPONSIVE
        ========================== */

        @media(max-width: 1050px) {

            .hero {
                flex-direction: column;
                text-align: center;
                gap: 25px;
            }

            .hero-buttons {
                justify-content: center;
            }

            .about-container {
                grid-template-columns: 1fr;
            }

        }

        @media(max-width: 750px) {

            nav ul {
                display: none;
            }

            .hero {
                padding: 85px 6% 35px;
            }

            .profile-circle {
                width: 220px;
                height: 220px;
            }

            .hero h1 {
                font-size: 40px;
            }

            section {
                padding: 38px 6%;
            }

            .cv-image-wrapper img {
                height: 380px;
            }

            .cv-buttons {
                flex-direction: column;
                align-items: center;
            }

        }

    </style>

</head>


